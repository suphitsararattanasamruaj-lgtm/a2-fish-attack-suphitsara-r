Fish)\n        big_fish_facing_left = True\n        vertical_speed2 = randint(10, 20)\n        if randint(0, 1) == 0:\n            vertical_speed2 = 0 - vertical_speed2\n        big_fish.set_position(140, randint(20, 100))\n        big_fish.set_velocity(-30, vertical_speed2)\n        # Never destroy the big fish at the screen edge\n        big_fish.set_flag(SpriteFlag.AUTO_DESTROY, False)\ngame.on_update_interval(4000, on_update_interval)\n\n# Reference: https://arcade.makecode.com/reference/game/on-update-interval\n# The reference repeats a function after a chosen number of milliseconds.\n# My code uses 4000 to check whether a big fish needs spawning every 4 seconds.\n# Reference: https://arcade.makecode.com/reference/sprites/all-of-kind\n# The reference returns all sprites of a kind: my code checks that list's length is 0 before creating a BigFish, keeping only one big fish at a time.\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/set-flag\n# The reference describes AutoDestroy for removing offscreen sprites.\n# My code sets AUTO_DESTROY False so the big fish remains available to bounce.\n# It starts moving left at 30 pixels per second with random vertical movement.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 18. SPAWN SMALL FISH\n# Unlike big fish, small fish are created without checking whether others already exist.\n# This allows several small fish to be in the game at the same time.\n# A negative left/right speed moves a fish left, a positive speed moves it right.\n\ndef on_update_interval2():\n    global small_fish, vertical_speed\n    small_fish = sprites.create(assets.image(\"\"\"\n            SmallFish0\n            \"\"\"),\n        SpriteKind.SmallFish)\n    vertical_speed = randint(8, 20)\n    if randint(0, 1) == 0:\n        vertical_speed = 0 - vertical_speed\n    if randint(0, 1) == 0:\n        small_fish.set_image(assets.image(\"\"\"\n            SmallFish0\n            \"\"\"))\n        small_fish.set_position(155, randint(15, 105))\n        small_fish.set_velocity(-40, vertical_speed)\n    else:\n        small_fish.set_image(assets.image(\"\"\"\n            Right facing small fish\n            \"\"\"))\n        small_fish.set_position(5, randint(15, 105))\n        small_fish.set_velocity(40, vertical_speed)\n    small_fish.set_flag(SpriteFlag.AUTO_DESTROY, True)\ngame.on_update_interval(1500, on_update_interval2)\n\n# Reference: https://arcade.makecode.com/reference/game/on-update-interval\n# The reference schedules repeated code: my code uses 1500 for a fish every 1.5 seconds.\n# Reference: https://arcade.makecode.com/reference/math/randint\n# The reference chooses a whole number between two limits.\n# My code uses randint(0, 1) to select a side, randint(15, 105) for its height, and randint(8, 20) for vertical speed: the image and horizontal speed match the side.\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/set-flag\n# The reference explains automatic removal when a sprite leaves the screen.\n# My code sets AUTO_DESTROY True so small fish disappear after swimming offscreen.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 19. KILLER WHALE MOVEMENT\n# This movement check runs repeatedly.\n# The whale must exist before the code can check its position or change its movement.\n# abs() removes a minus sign: abs(-45) becomes 45.\n# Using 0 - abs() makes the speed negative, so the whale can turn left or up.\n\ndef on_forever():\n    global whale_facing_left\n    if killer_whale != None:\n        # Left edge\n        if killer_whale.left <= 0 and killer_whale.vx < 0:\n            killer_whale.left = 0\n            killer_whale.vx = abs(killer_whale.vx)\n        elif killer_whale.right >= 160 and killer_whale.vx > 0:\n            # Right edge\n            killer_whale.right = 160\n            killer_whale.vx = 0 - abs(killer_whale.vx)\n        # Top edge\n        if killer_whale.top <= 0 and killer_whale.vy < 0:\n            killer_whale.top = 0\n            killer_whale.vy = abs(killer_whale.vy)\n        elif killer_whale.bottom >= 120 and killer_whale.vy > 0:\n            # Bottom edge\n            killer_whale.bottom = 120\n            killer_whale.vy = 0 - abs(killer_whale.vy)\n        # Face right\n        if killer_whale.vx > 0 and whale_facing_left:\n            killer_whale.image.flip_x()\n            whale_facing_left = False\n        elif killer_whale.vx < 0 and not (whale_facing_left):\n            # Face left\n            killer_whale.image.flip_x()\n            whale_facing_left = True\nforever(on_forever)\n\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/vx\n# The \"Go to each side\" example changes horizontal velocity to reverse direction.\n# My code uses the whale's left/right edges at 0 and 160, plus its current direction,then sets a positive or negative vx so it moves back into the screen.\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/vy\n# The reference explains vertical velocity. My code applies the same reversal to top/bottom edges at 0 and 120, keeping the whale inside the play area.\n# Reference: https://arcade.makecode.com/reference/images/image/flip-x\n# The reference mirrors pixels horizontally: my code flips the whale when vx disagrees with whale_facing_left, then updates the flag to avoid repeated flips.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 20. LARGE SHARK GROWTH\n# Both checks must be true: the score must be at least 50 AND the shark must be level 2.\n# After the level changes to 3, this condition is no longer true, so the growth sound\n# does not keep playing each time the function checks again.\n\ndef on_forever2():\n    global shark_level\n    if info.score() >= 50 and shark_level == 2:\n        shark_level = 3\n        change_shark_image(assets.image(\"\"\"\n            BiG Shark\n            \"\"\"))\n        play_growth_sound()\nforever(on_forever2)\n\n# Reference: https://arcade.makecode.com/reference/info/score\n# The reference reads the player's current score with info.score().\n# My code compares that value with 50 as the requirement for the largest shark.\n# Reference: https://docs.python.org/3/tutorial/controlflow.html#if-statements\n# The tutorial uses if to run code only when a condition is true.\n# My code also requires shark_level == 2, then changes it to 3, replaces the image and plays the growth sound. Changing the level prevents repeated growth.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 21. SMALL FISH VERTICAL MOVEMENT\n# current_fish means the fish being checked during this turn through the list.\n# After checking one fish, the loop moves to the next.\n# These checks only turn fish at the top and bottom, so they can still leave at the sides.\n\ndef on_forever3():\n    for current_fish in sprites.all_of_kind(SpriteKind.SmallFish):\n        if current_fish.top <= 0 and current_fish.vy < 0:\n            current_fish.top = 0\n            current_fish.vy = abs(current_fish.vy)\n        elif current_fish.bottom >= 120 and current_fish.vy > 0:\n            current_fish.bottom = 120\n            current_fish.vy = 0 - abs(current_fish.vy)\nforever(on_forever3)\n\n# Reference: https://arcade.makecode.com/reference/sprites/all-of-kind\n# The reference collects every sprite of a selected kind.\n# My code loops through all SmallFish so the edge check applies to every fish.\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/vy\n# The reference explains that positive vy moves down and negative vy moves up.\n# My code sets vy positive at the top (0) and negative at the bottom (120), only when a fish is moving outwards. Horizontal movement stays unchanged.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 22. SHARK FACING DIRECTION\n# Moving only up or down does not change which way the shark faces.\n# If its left/right speed is zero, neither turning condition is true.\n\ndef on_forever4():\n    global shark_facing_right\n    if shark != None:\n        if shark.vx > 0 and not (shark_facing_right):\n            shark.image.flip_x()\n            shark_facing_right = True\n        elif shark.vx < 0 and shark_facing_right:\n            shark.image.flip_x()\n            shark_facing_right = False\nforever(on_forever4)\n\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/vx\n# The reference explains that positive vx means right and negative vx means left.\n# My code checks shark.vx to work out which way the player is swimming.\n# Reference: https://arcade.makecode.com/reference/images/image/flip-x\n# The reference mirrors an image horizontally with flip_x().\n# My code flips only when movement disagrees with shark_facing_right, then updates that flag so the shark does not keep flipping while swimming straight.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 23. BIG FISH MOVEMENT\n# The code checks both the fish position and its movement direction.\n# For example, it turns a fish at the left edge only if the fish is still moving left.\n# A fish already moving back to the right is allowed to continue without turning again.\n\ndef on_forever5():\n    global big_fish_facing_left\n    if big_fish != None:\n        # Left edge\n        if big_fish.left <= 0 and big_fish.vx < 0:\n            big_fish.left = 0\n            big_fish.vx = abs(big_fish.vx)\n        elif big_fish.right >= 160 and big_fish.vx > 0:\n            # Right edge\n            big_fish.right = 160\n            big_fish.vx = 0 - abs(big_fish.vx)\n        # Top edge\n        if big_fish.top <= 0 and big_fish.vy < 0:\n            big_fish.top = 0\n            big_fish.vy = abs(big_fish.vy)\n        elif big_fish.bottom >= 120 and big_fish.vy > 0:\n            # Bottom edge\n            big_fish.bottom = 120\n            big_fish.vy = 0 - abs(big_fish.vy)\n        # Face right\n        if big_fish.vx > 0 and big_fish_facing_left:\n            big_fish.image.flip_x()\n            big_fish_facing_left = False\n        elif big_fish.vx < 0 and not (big_fish_facing_left):\n            # Face left\n            big_fish.image.flip_x()\n            big_fish_facing_left = True\nforever(on_forever5)\n\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/vx\n# The \"Go to each side\" example reverses horizontal movement by changing vx.\n# My code checks left <= 0 or right >= 160 only while the fish moves outwards,puts its edge back on the boundary, then changes vx to point into the screen.\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/vy\n# The reference explains vertical movement: my code reverses vy at 0 and 120 too.\n# These position and direction checks make the big fish bounce back at each edge.\n# Reference: https://arcade.makecode.com/reference/images/image/flip-x\n# The reference flips an image left-to-right. My code uses big_fish_facing_left with vx to flip once per turn, keeping the picture facing its swimming direction.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 24. SPAWN KILLER WHALE\n# Whales can appear before the shark reaches level 3.\n# The level controls whether the shark can eat a whale, not whether a whale can appear.\n# If a whale is still present at the next 8 second check, no extra whale is created.\n\ndef on_update_interval3():\n    global killer_whale, whale_facing_left\n    if len(sprites.all_of_kind(SpriteKind.KillerWhale)) == 0:\n        killer_whale = sprites.create(img(\"\"\"\n                ............dd................\n                ............dd................\n                ............df................\n                ...........ddff...............\n                ...........dfff...............\n                ..........dffff...............\n                .........dffffffd.............\n                .....dddddfffffffdd...........\n                ....dfffffffffffffffddd...dddf\n                ..ddffff1fffffffffffffff.dfff.\n                .dffffff1fffffffffffffffdffff.\n                .fffffffff11ffffff11fffffd....\n                .fff111111ffffff1111fffffd....\n                .f1111111fffffff1111....ffdd..\n                .1111111ffffff111111....fffd..\n                ........ffffff............fff.\n                .........fffff................\n                ..........fff.................\n                ...........ff.................\n                ..............................\n                \"\"\"),\n            SpriteKind.KillerWhale)\n        whale_facing_left = True\n        vertical_speed3 = randint(15, 30)\n        if randint(0, 1) == 0:\n            vertical_speed3 = 0 - vertical_speed3\n        killer_whale.set_position(140, randint(25, 95))\n        killer_whale.set_velocity(-45, vertical_speed3)\n        killer_whale.set_flag(SpriteFlag.AUTO_DESTROY, False)\ngame.on_update_interval(8000, on_update_interval3)\n\n# Reference: https://arcade.makecode.com/reference/game/on-update-interval\n# The reference repeats a function at a set interval: my code uses 8000 for 8 seconds.\n# Reference: https://arcade.makecode.com/reference/sprites/all-of-kind\n# The reference lists sprites of a chosen kind. My code creates a KillerWhale only when that list is empty, preventing multiple whales from spawning together.\n# Reference: https://arcade.makecode.com/reference/sprites/sprite/set-flag\n# The reference explains AutoDestroy: my code sets it False to keep the whale from being removed offscreen before the movement code can turn it back.\n# Its starting velocity is -45 horizontally, with a random vertical speed of 15-30.\n# ============================================================================================================================================================================\n# 25. HUNGER SYSTEM\n# This is a separate repeating timer from the twominute game countdown.\n# It does not check can_take_damage, so protection from fish or whale hits\n# does not stop hunger from removing a heart.\n\ndef on_update_interval4():\n    info.change_life_by(-1)\ngame.on_update_interval(10000, on_update_interval4)\n","images.g.jres":"{\n    \"image4\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAMwAAAAAAAAMwAAAAAAAAMzMADAAAAAAwM8MMAAAAAAAzwwwAAADAADPMDAAAAMDMM8wDAAAAAMwzMwMAAAAAwDzzAwAAAAAAMDMAAAAAAAAwMwAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"Medium Shark\"\n    },\n    \"image1\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADMDAAAAAAAw/z8DAAAAADD/PwMAAAAAMP8/AwAAAAAwMzMDAAAAADAzMwMAAAAAADMDAAAAAAAAMwMAAAAAAAAzAwAAAAAAMAAwAwAAAAAwADADAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"SmallFish\"\n    },\n    \"image6\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"BiG Shark\"\n    },\n    \"image2\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAzMwAAAAAAADMzAAAAAAAyv/MDAAAAADK/8wMAAAAAMPMwwMAAAAww8o6MwAAADPDysMzAAAAAACsrDAAAAAAMMOsAAAAAAAzzAAMAAAAAMPMAAwAAAAAzAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"Left facing big fish\"\n    },\n    \"image7\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAwAAAAAAAAADMDAAAAAAAwPzMAAAAAAAzzMMAAAAAMMPMMwAAAAAAAMMMAAAAAAAwDMwAAAAAAMAAwAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"SmallFish0\"\n    },\n    \"image3\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAMAAwAAAAAAAMAzMAAAAAAAAwwwAAAAAMMPMMwAAAAAAM8zDAAAAAADA/MwAAAAAAADMDAAAAAAAAMAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"Right facing small fish\"\n    },\n    \"image5\": {\n        \"data\": \"hwQQABAAAAAAAADQAAAAA