,"main.py":"@namespace\nclass SpriteKind:\n    SmallFish = SpriteKind.create()\n    BigFish = SpriteKind.create()\n    KillerWhale = SpriteKind.create()\n\n# BIG-FISH COLLISION\n\ndef on_on_overlap(player_sprite, touched_fish):\n    global big_fish, can_take_damage\n    if shark_level >= 2:\n        # Medium and large sharks can eat the big fish\n        sprites.destroy(touched_fish)\n        big_fish = None\n        info.change_score_by(3)\n        info.change_life_by(1)\n        if info.life() > 3:\n            info.set_life(3)\n    elif can_take_damage:\n        can_take_damage = False\n        info.change_life_by(-1)\n        # Give the shark temporary protection\n        pause(1500)\n        can_take_damage = True\nsprites.on_overlap(SpriteKind.player, SpriteKind.BigFish, on_on_overlap)\n\n# SMALL-FISH COLLISION\n\ndef on_on_overlap2(player_sprite3, touched_fish2):\n    global shark_level\n    # Small fish are eaten, so they should disappear\n    sprites.destroy(touched_fish2)\n    info.change_score_by(1)\n    info.change_life_by(1)\n    # Maximum of three hearts\n    if info.life() > 3:\n        info.set_life(3)\n    # Grow into the medium shark\n    if info.score() >= 5 and shark_level == 1:\n        shark_level = 2\n        shark.set_image(assets.image(\"\"\"\n            Medium Shark new\n            \"\"\"))\nsprites.on_overlap(SpriteKind.player, SpriteKind.SmallFish, on_on_overlap2)\n\n# KILLER-WHALE COLLISION\n\ndef on_on_overlap3(player_sprite2, touched_whale):\n    global killer_whale, can_take_damage\n    if shark_level >= 3:\n        # Final-stage shark can eat the whale\n        sprites.destroy(touched_whale)\n        killer_whale = None\n        info.change_score_by(10)\n        info.change_life_by(1)\n        if info.life() > 3:\n            info.set_life(3)\n    elif can_take_damage:\n        can_take_damage = False\n        info.change_life_by(-1)\n        # Give the shark temporary protection\n        pause(1500)\n        can_take_damage = True