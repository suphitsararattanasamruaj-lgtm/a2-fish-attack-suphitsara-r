e score must be at least 50 AND the shark must be level 2.\n# After the level changes to 3, this condition is no longer true, so the growth sound\n# does not keep playing each time the function checks again.\n\ndef on_forever2():\n    global shark_level\n    if info.score() >= 50 and shark_level == 2:\n        shark_level = 3\n        change_shark_image(assets.image(\"\"\"\n            BiG Shark\n            \"\"\"))\n        play_growth_sound()\nforever(on_forever2)\n\n# Reference: https://arcade.makecode.com/reference/info/score\n# The reference reads the player's current score with info.score().\n# My code compares that value with 50 as the requirement for the largest shark.\n# Reference: https://docs.python.org/3/tutorial/controlflow.html#if-statements\n# The tutorial uses if to run code only when a condition is true.\n# My code also requires shark_level == 2, then changes it to 3, replaces the image and plays the growth sound. Changing the level prevents repeated growth.\n# ============================================================================================================================================================================\n# ============================================================================================================================================================================\n# 21. SMALL FISH VERTICAL MOVEMENT\n# current_fish means the fish being checked during this turn through the list.\n# After checking one fish, the loop moves to the next.\n# These checks only turn fish at the top and bottom, so they can still leave at the sides.\n\ndef on_forever3():\n    for current_fish in sprites.all_of_kind(SpriteKind.SmallFish):\n        if current_fish.top <= 0 and current_fish.vy < 0:\n            current_fish.top = 0\n            current_fish.vy = abs(current_fish.vy)\n        elif current_fish.bottom >= 120 and current_fish.vy > 0:\n            current_fish.bottom = 120\n            current_fish.vy = 0 - abs(current_fish.v